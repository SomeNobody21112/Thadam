{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MPLADS: Run everything",
      "dependsOn": ["MPLADS: API", "MPLADS: Frontend"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "MPLADS: API",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "uvicorn", "mplads.api.app:app", "--port", "8000", "--reload"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": {
        "group": "mplads",
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": {
        "pattern": [{ "regexp": "^\\s*File \"(.*)\", line (\\d+)", "file": 1, "line": 2 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started (server process|reloader)",
          "endsPattern": "Application startup complete"
        }
      }
    },
    {
      "label": "MPLADS: Frontend",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": {
        "group": "mplads",
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": {
        "pattern": [{ "regexp": "^\\s*(.*):(\\d+):(\\d+):\\s+(.*)$", "file": 1, "line": 2, "column": 3, "message": 4 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "MPLADS: Tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest", "-q"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "MPLADS: Build frontend",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "build"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "MPLADS: Rebuild artifacts (ingest, train, pipeline)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "mplads.cli", "pipeline"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "MPLADS: Free the demo ports (8000/5173/5174)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Get-NetTCPConnection -State Listen -LocalPort 8000,5173,5174 -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Write-Host \"stopping PID $_\"; Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue }; Write-Host 'ports free'"
      ],
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    }
  ]
}
