{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],
  "python.analysis.extraPaths": ["${workspaceFolder}/src"],

  // PowerShell's execution policy on this machine blocks npm.ps1, so the integrated
  // terminal defaults to cmd for npm. Tasks call npm.cmd explicitly for the same reason.
  "terminal.integrated.defaultProfile.windows": "Command Prompt",

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.egg-info": true,
    "frontend/.vite": true,
    "frontend/dist": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/data/artifacts": true,
    "**/data/interim": true,
    "Dataset": true,
    "frontend/dist": true
  },
  // Dataset/ is read-only by project rule; keep the editor from offering to write to it.
  "files.readonlyInclude": { "Dataset/**": true }
}
